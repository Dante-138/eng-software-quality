{
  "name": "eng-software-quality",
  "version": "0.1.0",
  "private": true,
  "description": "Guia e template de portão de qualidade para projetos feitos com agentes de IA",
  "type": "module",
  "license": "MIT",
  "scripts": {
    "prepare": "git config core.hooksPath .githooks",
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview --host 127.0.0.1 --port 4173 --strictPort",
    "lint": "eslint . --max-warnings 0 && node tools/verificar-escapes.ts",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc -p tsconfig.json && tsc -p tsconfig.nucleo.json",
    "test": "vitest run --coverage",
    "test:navegador": "playwright test",
    "test:navegador:docker": "node tools/navegador-docker.mjs",
    "test:mutacao": "stryker run",
    "lint:actions": "node tools/auditar-workflows.mjs",
    "commits": "node tools/verificar-commits.ts origin/main",
    "versoes": "node tools/verificar-imagem-playwright.ts",
    "check": "npm run commits && npm run versoes && npm run lint && npm run format:check && npm run typecheck && npm test && npm run build"
  },
  "engines": {
    "node": ">=22.18"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.65.1",
    "@stryker-mutator/core": "10.1.1",
    "@stryker-mutator/vitest-runner": "10.1.1",
    "@types/node": "24.19.2",
    "@vitest/coverage-v8": "5.1.0",
    "eslint": "10.15.0",
    "fast-check": "4.10.2",
    "globals": "17.14.0",
    "prettier": "3.10.1",
    "typescript": "7.0.2",
    "typescript-eslint": "8.73.0",
    "vite": "8.3.8",
    "vitest": "5.1.0"
  },
  "overrides": {
    "minimatch": "11.0.8",
    "qs": "6.16.1",
    "playwright-core": "1.65.0"
  }
}
